.earth-circumference-tile:hover  { border-color: rgba(80,180,255,0.54); }

.geo-model-tile {
  position: relative; overflow: hidden;
  background:
    linear-gradient(165deg, rgba(28,20,4,0.10) 0%, rgba(20,15,4,0.92) 100%),
