  --surface-page: #101214;
  --surface-page-alt: #0a0c0e;
  --surface-panel: rgba(24, 27, 31, 0.94);
  --surface-panel-alt: rgba(16, 18, 20, 0.98);
  --surface-elevated: #1c2229;
