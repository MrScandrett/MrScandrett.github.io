/* =========================================================
   ClassroomOS Home Polish Pass
   ========================================================= */
.cos-home {
  --cos-card-radius: 16px;
  --cos-section-gap: clamp(1.4rem, 3vw, 2.25rem);
  --cos-card-border: color-mix(in srgb, var(--border-default, #d2d2d7) 62%, transparent);
  --cos-card-bg:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.58)),
    var(--surface-panel, rgba(255, 255, 255, 0.92));
  --cos-card-shadow:
    0 16px 38px rgba(15, 23, 42, 0.075),
    inset 0 1px 0 rgba(255, 255, 255, 0.72);
}

.cos-home .home-launchpad {
  padding-top: clamp(2.35rem, 5vw, 4.75rem);
  padding-bottom: var(--cos-section-gap);
}

.cos-home .today-panel,
.cos-home .launch-grid-section,
.cos-home .media-spotlight-grid {
  padding-top: var(--cos-section-gap);
}

.cos-hero-grid {
  gap: clamp(1rem, 2.4vw, 1.65rem);
}

.cos-hero-copy {
  isolation: isolate;
  background:
    radial-gradient(circle at 88% 16%, color-mix(in srgb, var(--theme-accent, #0071e3) 20%, transparent), transparent 28%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.52)),
    var(--surface-panel, rgba(255, 255, 255, 0.92));
}

.cos-hero-copy::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    linear-gradient(90deg, color-mix(in srgb, var(--theme-accent, #0071e3) 36%, transparent), transparent 44%) top left / 100% 3px no-repeat;
  pointer-events: none;
  z-index: -1;
}

.cos-hero-copy > * {
  position: relative;
  z-index: 1;
}

.cos-home .home-hero-title {
  max-width: 9ch;
  text-wrap: balance;
}

.cos-home .home-hero-subtitle {
  max-width: 13ch;
  text-wrap: balance;
}

.cos-home .home-hero-lede {
  max-width: 42rem;
  margin: 0.85rem 0 0;
  color: var(--text-secondary, var(--muted));
  font-size: clamp(1rem, 1.45vw, 1.16rem);
  font-weight: 600;
  line-height: 1.5;
}

.class-mode-badges {
  margin-top: 1.45rem;
  margin-bottom: 0.5rem;
}

.class-mode-badges span {
  background: color-mix(in srgb, var(--surface-elevated, #fff) 74%, var(--theme-accent-soft, rgba(0, 113, 227, 0.12)));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.58);
}

.mission-card {
  background:
    radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--theme-accent, #0071e3) 16%, transparent), transparent 34%),
    var(--cos-card-bg);
}

.mission-list li {
  padding: 0.48rem 0;
  border-bottom: 1px solid color-mix(in srgb, var(--cos-card-border) 70%, transparent);
}

.mission-list li:last-child {
  border-bottom: 0;
}

.command-anchor {
  background: color-mix(in srgb, var(--surface-elevated, #fff) 78%, transparent);
}

.cos-home .section-heading h2 {
  letter-spacing: 0;
  text-wrap: balance;
}

.cos-home .home-widget,
.cos-home .home-launch-card {
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.cos-home .home-widget:hover,
.cos-home .tile-grid--secondary-simplified .home-launch-card:hover,
.cos-home .tile-grid--secondary-simplified .home-launch-card:focus-visible {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--theme-accent, #0071e3) 34%, var(--cos-card-border));
  box-shadow:
    0 20px 44px rgba(15, 23, 42, 0.1),
    0 0 0 3px color-mix(in srgb, var(--theme-accent, #0071e3) 10%, transparent),
    inset 0 1px 0 rgba(255, 255, 255, 0.72);
}

.cos-home .tile-grid--secondary-simplified .home-launch-card {
  min-height: 190px;
  gap: 0.85rem;
}

.cos-home .tile-grid--secondary-simplified .card-emoji {
  width: 3.35rem;
  height: 3.35rem;
  display: grid;
  place-items: center;
  border-radius: 14px;
}

.cos-home .home-widget--vod {
  overflow: hidden;
}

.student-spotlight {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.spotlight-link,
.vod-link {
  text-underline-offset: 0.18em;
}

html[data-lighting="night"] .cos-home {
  --cos-card-border: rgba(255, 255, 255, 0.09);
  --cos-card-bg:
    linear-gradient(180deg, rgba(38, 40, 46, 0.88), rgba(25, 27, 32, 0.8)),
    var(--surface-panel, rgba(33, 34, 38, 0.94));
  --cos-card-shadow:
    0 18px 42px rgba(0, 0, 0, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

html[data-lighting="night"] .cos-hero-copy {
  background:
    radial-gradient(circle at 88% 16%, color-mix(in srgb, var(--theme-accent, #69a8ff) 18%, transparent), transparent 30%),
    var(--cos-card-bg);
}

@media (max-width: 900px) {
  .cos-hero-grid,
  .media-spotlight-grid,
  .today-grid {
    gap: 0.85rem;
  }
}

@media (max-width: 560px) {
  .cos-home {
    --cos-card-radius: 14px;
  }

  .cos-hero-copy,
  .mission-card,
  .cos-home .home-widget,
  .cos-home .home-launch-card {
    border-radius: var(--cos-card-radius);
  }
}

/* =============================================================
   WORD OF THE DAY WIDGET
   ============================================================= */
.home-widget--wotd {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.wotd-subject-badge {
  display: inline-flex;
  align-items: center;
  height: 1.45rem;
  padding: 0 0.55rem;
  border-radius: 999px;
  background: var(--accent-soft, rgba(0,113,227,0.12));
  color: var(--accent, #0071e3);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  align-self: flex-start;
}
.wotd-subject-badge[data-subject="Physics"]     { background: rgba(99,102,241,0.13); color: #6366f1; }
.wotd-subject-badge[data-subject="Math"]        { background: rgba(16,185,129,0.13); color: #059669; }
.wotd-subject-badge[data-subject="Biology"]     { background: rgba(34,197,94,0.13);  color: #16a34a; }
.wotd-subject-badge[data-subject="Music"]       { background: rgba(236,72,153,0.13); color: #db2777; }
.wotd-subject-badge[data-subject="Art"]         { background: rgba(234,88,12,0.13);  color: #ea580c; }
.wotd-subject-badge[data-subject="Technology"]  { background: rgba(6,182,212,0.13);  color: #0891b2; }
.wotd-subject-badge[data-subject="Engineering"] { background: rgba(245,158,11,0.13); color: #d97706; }

.wotd-term {
  margin: 0;
  color: var(--text-primary, var(--text));
  font-size: 2rem;
  letter-spacing: -0.03em;
  line-height: 1;
}
.wotd-pron {
  margin: 0;
  color: var(--text-muted, var(--muted));
  font-size: 0.83rem;
  font-style: italic;
}
.wotd-grade {
  margin: 0;
  color: var(--text-subtle, var(--muted));
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.wotd-def {
  margin: 0;
  color: var(--text-body, var(--text));
  font-size: 0.9rem;
  line-height: 1.6;
  flex: 1;
}
.wotd-example {
  margin: 0;
  padding: 0.48rem 0.72rem;
  border-left: 3px solid var(--accent, #0071e3);
  color: var(--text-muted, var(--muted));
  font-size: 0.82rem;
  font-style: italic;
  line-height: 1.55;
  background: var(--accent-soft, rgba(0,113,227,0.05));
  border-radius: 0 8px 8px 0;
}
.wotd-fact-box {
  display: flex;
  gap: 0.45rem;
  align-items: flex-start;
  padding: 0.5rem 0.65rem;
  background: rgba(251,191,36,0.1);
  border: 1px solid rgba(251,191,36,0.22);
  border-radius: 10px;
  font-size: 0.81rem;
  line-height: 1.5;
  color: var(--text-body, var(--text));
}
.wotd-fact-icon { flex-shrink: 0; font-size: 0.9rem; }
.wotd-lesson-link {
  display: inline-flex;
  align-items: center;
  color: var(--accent, #0071e3);
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  margin-top: auto;
}
.wotd-lesson-link:hover { text-decoration: underline; }

/* =============================================================
   CLASSROOM TIMER WIDGET
   ============================================================= */
.home-widget--timer { grid-column: 1 / -1; }

.timer-layout {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 1.5rem;
  align-items: start;
}
.timer-col-clock {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}
.timer-ring-wrap {
  position: relative;
  width: 160px;
  height: 160px;
  flex-shrink: 0;
}
.timer-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.timer-track {
  fill: none;
  stroke: var(--border-default, rgba(210,210,215,0.5));
  stroke-width: 9;
  stroke-dasharray: 1 4.5;
  stroke-linecap: round;
}
.timer-arc {
  fill: none;
  stroke: var(--accent, #0071e3);
  stroke-width: 9;
  stroke-linecap: round;
  stroke-dasharray: 427.26;
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 0.85s linear, stroke 0.3s ease;
}
.timer-arc.is-warning { stroke: #f59e0b; }
.timer-arc.is-danger  { stroke: #ef4444; }
.timer-arc.is-done    { stroke: #22c55e; }
.timer-face {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.12rem;
  pointer-events: none;
}
.timer-digits {
  font-family: var(--font-mono, monospace);
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--text-primary, var(--text));
  line-height: 1;
}
.timer-digits.is-done { color: #22c55e; }
@keyframes timer-pulse { 0%,100%{opacity:1} 50%{opacity:0.35} }
.timer-digits.is-pulsing { animation: timer-pulse 0.55s ease infinite; }
.timer-activity-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted, var(--muted));
  text-align: center;
  max-width: 9ch;
  line-height: 1.2;
}
.timer-controls {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  justify-content: center;
}
.timer-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.1rem;
  padding: 0 0.85rem;
  border: 1px solid var(--border-default, #d2d2d7);
  border-radius: 999px;
  background: var(--surface-panel, rgba(255,255,255,0.88));
  color: var(--text-primary, var(--text));
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: transform 120ms ease, background 120ms ease;
  white-space: nowrap;
}
.timer-btn:hover:not(:disabled) { background: var(--surface-elevated,#fff); transform: translateY(-1px); }
.timer-btn:disabled { opacity: 0.36; cursor: default; }
.timer-btn--start { background: var(--accent,#0071e3); border-color: transparent; color: #fff; }
.timer-btn--start:hover:not(:disabled) { background: var(--accent-hover,#005ec3); }

.timer-col-config { display: flex; flex-direction: column; gap: 0.9rem; }
.timer-config-label {
  margin: 0 0 0.38rem;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted, var(--muted));
}
.timer-preset-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 0.4rem;
}
.timer-preset-btn {
  display: flex;
  flex-direction: column;
  gap: 0.08rem;
  min-width: 0;
  padding: 0.46rem 0.58rem;
  border: 1px solid var(--border-subtle, rgba(210,210,215,0.5));
  border-radius: 10px;
  background: var(--surface-panel, rgba(255,255,255,0.7));
  color: var(--text-primary, var(--text));
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
  line-height: 1.2;
  overflow-wrap: anywhere;
  transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
}
.timer-preset-btn span { font-size: 0.68rem; font-weight: 400; color: var(--text-muted,var(--muted)); }
.timer-preset-btn:hover { border-color: var(--accent,#0071e3); background: var(--accent-soft,rgba(0,113,227,0.07)); transform: translateY(-1px); }
.timer-preset-btn.is-active { border-color: var(--accent,#0071e3); background: var(--accent-soft,rgba(0,113,227,0.11)); color: var(--accent,#0071e3); }
.timer-preset-btn.is-active span { color: var(--accent,#0071e3); opacity: 0.8; }

.timer-custom-row { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
.timer-num-input {
  width: 3.6rem;
  padding: 0.38rem 0.42rem;
  border: 1px solid var(--border-default,#d2d2d7);
  border-radius: 8px;
  background: var(--surface-panel,rgba(255,255,255,0.9));
  color: var(--text-primary,var(--text));
  font-family: var(--font-mono,monospace);
  font-size: 1rem;
  font-weight: 700;
  text-align: center;
  -moz-appearance: textfield;
}
.timer-num-input::-webkit-outer-spin-button,
.timer-num-input::-webkit-inner-spin-button { -webkit-appearance: none; }
.timer-colon { font-size: 1rem; font-weight: 700; color: var(--text-muted,var(--muted)); }
.timer-set-btn {
  padding: 0.38rem 0.82rem;
  border: 1px solid var(--accent,#0071e3);
  border-radius: 8px;
  background: transparent;
  color: var(--accent,#0071e3);
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 120ms ease, color 120ms ease;
}
.timer-set-btn:hover { background: var(--accent,#0071e3); color: #fff; }

@media (max-width: 680px) {
  .timer-layout { grid-template-columns: 1fr; justify-items: center; }
}

/* Mini analog clock accent — remixed from a Uiverse.io snippet by chase2k25 */
.timer-clock-head { display: flex; align-items: center; gap: 0.45rem; }
.mini-clock {
  position: relative;
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--surface-elevated, #fff);
  box-shadow:
    2px 2px 4px rgba(0,0,0,0.16),
    -2px -2px 4px rgba(255,255,255,0.4),
    inset 0 0 0 1px var(--border-default, rgba(210,210,215,0.5));
}
.mini-clock-tick { position: absolute; background: var(--text-muted, var(--muted)); border-radius: 1px; }
.mini-clock-tick--12, .mini-clock-tick--6 { left: 50%; width: 1.5px; height: 2.5px; transform: translateX(-50%); }
.mini-clock-tick--12 { top: 2px; }
.mini-clock-tick--6 { bottom: 2px; }
.mini-clock-tick--3, .mini-clock-tick--9 { top: 50%; width: 2.5px; height: 1.5px; transform: translateY(-50%); }
.mini-clock-tick--3 { right: 2px; }
.mini-clock-tick--9 { left: 2px; }
.mini-clock-hand { position: absolute; bottom: 50%; left: 50%; transform-origin: bottom center; border-radius: 2px 2px 0 0; }
.mini-clock-hand--hour { width: 1.4px; height: 6.5px; background: var(--text-primary, var(--text)); }
.mini-clock-hand--min { width: 1.1px; height: 9.5px; background: var(--text-muted, var(--muted)); }
.mini-clock-hand--sec { width: 1px; height: 10.5px; background: var(--accent, #0071e3); transition: transform 0.15s cubic-bezier(0.4,2.3,0.6,1); }
.mini-clock-pin { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 3px; height: 3px; border-radius: 50%; background: var(--text-primary, var(--text)); }
@media (prefers-reduced-motion: reduce) { .mini-clock-hand--sec { transition: none; } }

/* =============================================================
   LESSON OF THE DAY WIDGET
   ============================================================= */
.home-widget--lotd {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 1.75rem;
  align-items: center;
}
.lotd-main {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}
.lotd-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.1rem;
}
.lotd-shuffle {
  flex-shrink: 0;
  background: none;
  border: 1px solid var(--border-subtle, rgba(210,210,215,0.5));
  color: var(--text-muted, var(--muted, #888));
  border-radius: 8px;
  padding: 0.25rem 0.7rem;
  font-size: 0.71rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s, color 0.18s, border-color 0.18s;
  letter-spacing: 0.04em;
  line-height: 1.6;
}
.lotd-shuffle:hover {
  background: color-mix(in srgb, var(--lotd-color, #3b82f6) 10%, transparent);
  color: var(--lotd-color, #3b82f6);
  border-color: var(--lotd-color, #3b82f6);
}
.lotd-meta {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-wrap: wrap;
}
.lotd-subject-badge {
  display: inline-flex;
  align-items: center;
  height: 1.45rem;
  padding: 0 0.6rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--lotd-color, #3b82f6) 14%, transparent);
  color: var(--lotd-color, #3b82f6);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.lotd-track {
  font-size: 0.7rem;
  color: var(--text-muted, var(--muted, #888));
  font-weight: 500;
}
.lotd-track::before {
  content: '·';
  margin-right: 0.4rem;
  opacity: 0.5;
}
.lotd-title {
  margin: 0;
  font-size: clamp(1.05rem, 2vw, 1.3rem);
  font-weight: 700;
  color: var(--text-primary, var(--text));
  line-height: 1.2;
  letter-spacing: -0.01em;
}
.lotd-desc {
  margin: 0;
  font-size: 0.84rem;
  color: var(--text-body, var(--text));
  line-height: 1.6;
  max-width: 54ch;
}
.lotd-side {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  height: 100%;
  justify-content: center;
}
.lotd-impact-box {
  background: color-mix(in srgb, var(--lotd-color, #3b82f6) 7%, transparent);
  border: 1px solid color-mix(in srgb, var(--lotd-color, #3b82f6) 18%, transparent);
  border-left: 3px solid var(--lotd-color, #3b82f6);
  border-radius: 0 10px 10px 0;
  padding: 0.65rem 0.9rem;
}
.lotd-impact-label {
  display: block;
  font-size: 0.61rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--lotd-color, #3b82f6);
  margin-bottom: 0.35rem;
}
.lotd-impact-text {
  margin: 0;
  font-size: 0.81rem;
  color: var(--text-body, var(--text));
  line-height: 1.6;
}
.lotd-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.58rem 1.2rem;
  border-radius: 10px;
  background: var(--lotd-color, #3b82f6);
  color: #fff;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: opacity 0.18s, transform 0.15s;
  align-self: flex-start;
}
.lotd-cta:hover { opacity: 0.86; transform: translateY(-1px); }

@media (max-width: 680px) {
  .home-widget--lotd { grid-template-columns: 1fr; gap: 1rem; }
}

/* =============================================================
   PHYSICS & DRAWING SANDBOX
   ============================================================= */
.phys-sandbox-section {
  width: min(var(--cos-home-w,1180px), calc(100% - 2rem));
  margin-inline: auto;
  padding-top: 1.6rem;
}
.home-widget--phys { overflow: hidden; padding: 0 !important; }

.phys-tabs {
  display: flex;
  gap: 0.2rem;
  padding: 0.55rem 0.55rem 0;
  border-bottom: 1px solid var(--border-subtle,rgba(210,210,215,0.4));
}
.phys-tab {
  padding: 0.42rem 1rem;
  border: 1px solid transparent;
  border-bottom: none;
  border-radius: 10px 10px 0 0;
  background: transparent;
  color: var(--text-muted,var(--muted));
  font-size: 0.84rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 110ms ease, color 110ms ease;
}
.phys-tab.is-active {
  background: var(--surface-elevated,rgba(255,255,255,0.95));
  border-color: var(--border-subtle,rgba(210,210,215,0.5));
  color: var(--text-primary,var(--text));
}
.phys-panel { display: none; flex-direction: column; }
.phys-panel.is-active { display: flex; }

.phys-toolbar {
  display: flex;
  align-items: center;
  gap: 0.32rem;
  padding: 0.5rem 0.65rem;
  border-bottom: 1px solid var(--border-subtle,rgba(210,210,215,0.3));
  flex-wrap: wrap;
  background: var(--surface-panel-alt,rgba(248,250,252,0.6));
}
.ptool {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.05rem;
  height: 2.05rem;
  border: 1px solid var(--border-subtle,rgba(210,210,215,0.5));
  border-radius: 8px;
  background: transparent;
  cursor: pointer;
  font-size: 0.95rem;
  transition: background 100ms ease, border-color 100ms ease;
  flex-shrink: 0;
}
.ptool.is-active { background: var(--accent-soft,rgba(0,113,227,0.11)); border-color: var(--accent,#0071e3); }
.ptool:hover:not(.is-active) { background: var(--surface-page-alt,rgba(0,0,0,0.04)); }
.ptool-clear { margin-left: auto; }
.ptool-sep { width: 1px; height: 1.4rem; background: var(--border-subtle,rgba(210,210,215,0.5)); flex-shrink: 0; }

.ptool-color-wrap input[type="color"] {
  width: 2.05rem; height: 2.05rem;
  padding: 2px; border: 1px solid var(--border-subtle,rgba(210,210,215,0.5));
  border-radius: 8px; cursor: pointer; background: none;
}
.ptool-size-wrap input[type="range"] { width: 66px; accent-color: var(--accent,#0071e3); }
.ptool-gravity {
  display: flex; align-items: center; gap: 0.32rem;
  font-size: 0.8rem; font-weight: 500;
  color: var(--text-primary,var(--text)); cursor: pointer; user-select: none;
}
.ptool-gravity input { accent-color: var(--accent,#0071e3); }

.phys-canvas {
  display: block; width: 100%; height: 480px;
  cursor: crosshair; touch-action: none;
}

.phys-info-bar {
  display: flex; align-items: center; gap: 0.45rem;
  padding: 0.48rem 0.7rem;
  border-top: 1px solid var(--border-subtle,rgba(210,210,215,0.3));
  flex-wrap: wrap;
  background: var(--surface-panel-alt,rgba(248,250,252,0.5));
}
.phys-eq-pill {
  display: inline-flex; align-items: center;
  padding: 0.18rem 0.5rem;
  border: 1px solid var(--border-subtle,rgba(210,210,215,0.5));
  border-radius: 999px;
  background: var(--surface-page,rgba(255,255,255,0.6));
  color: var(--text-muted,var(--muted));
  font-family: var(--font-mono,monospace);
  font-size: 0.76rem;
  white-space: nowrap;
}
.phys-eq-live {
  font-size: 0.8rem; font-weight: 700;
  color: var(--accent,#0071e3);
  margin-left: auto;
}
.phys-ruler-val { font-size: 0.82rem; font-weight: 600; color: var(--accent,#0071e3); }

@media (max-width: 560px) { .phys-canvas { height: 320px; } }
@media (max-width: 780px) {
  .phys-sandbox-section { width: min(100% - 1rem, var(--cos-home-w,1180px)); }
}
