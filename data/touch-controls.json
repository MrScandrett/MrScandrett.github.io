{
  "_readme": [
    "On-screen controls for touch devices, keyed by app slug (see apps/manifest.json).",
    "Rendered by lib/touch-controls.js, which synthesizes the keydown/keyup events",
    "each game already listens for — codes below must match what the game reads.",
    "",
    "  side    'left' or 'right' screen corner",
    "  label   optional caption, used to tell two players apart",
    "  pad     any of up/down/left/right -> a key code; only the ones listed render",
    "  buttons { code, label, hold } — hold:false for one-shot actions (rotate,",
    "          restart, hard drop) so a long press can't wedge the key down",
    "",
    "Omit a slug entirely when the game is already usable by touch: blockopolis,",
    "jaelynn, kael and matthew are click-driven, and jumper ships its own controls.",
    "landscape:true shows a 'turn your phone sideways' hint on portrait phones."
  ],

  "mermaidgame": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "ArrowUp", "down": "ArrowDown", "left": "ArrowLeft", "right": "ArrowRight" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "Enter", "label": "Start", "hold": false },
          { "code": "KeyE", "label": "Use", "hold": false },
          { "code": "ShiftLeft", "label": "Dash" }
        ]
      }
    ]
  },

  "tetris-game": {
    "clusters": [
      {
        "side": "left",
        "pad": { "down": "ArrowDown", "left": "ArrowLeft", "right": "ArrowRight" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "ArrowUp", "label": "↻", "hold": false, "ariaLabel": "Rotate" },
          { "code": "Space", "label": "Drop", "hold": false }
        ]
      }
    ]
  },

  "asteroids": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "ArrowUp", "left": "ArrowLeft", "right": "ArrowRight" }
      },
      { "side": "right", "buttons": [{ "code": "Space", "label": "Fire" }] }
    ]
  },

  "crawlspace": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "ArrowUp", "down": "ArrowDown", "left": "ArrowLeft", "right": "ArrowRight" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "KeyQ", "label": "Quaff", "hold": false },
          { "code": "KeyR", "label": "Retry", "hold": false }
        ]
      }
    ]
  },

  "frog-bog": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "label": "P1",
        "pad": { "left": "KeyA", "right": "KeyD" },
        "buttons": [{ "code": "Space", "label": "Jump", "hold": false }]
      },
      {
        "side": "right",
        "label": "P2",
        "pad": { "left": "ArrowLeft", "right": "ArrowRight" },
        "buttons": [{ "code": "Enter", "label": "Jump", "hold": false }]
      }
    ]
  },

  "horse-v1": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "KeyE", "label": "Use", "hold": false },
          { "code": "KeyF", "label": "Dig", "hold": false },
          { "code": "KeyI", "label": "Bag", "hold": false },
          { "code": "ShiftLeft", "label": "Run" }
        ]
      }
    ]
  },

  "doms-folder": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" }
      },
      { "side": "right", "buttons": [{ "code": "KeyR", "label": "Retry", "hold": false }] }
    ]
  },

  "marko-s-project": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" }
      }
    ]
  },

  "maya": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "ArrowUp", "down": "ArrowDown", "left": "ArrowLeft", "right": "ArrowRight" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "ShiftLeft", "label": "Dash", "hold": false },
          { "code": "KeyR", "label": "Retry", "hold": false }
        ]
      }
    ]
  },

  "logan": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "left": "ArrowLeft", "right": "ArrowRight" }
      },
      { "side": "right", "buttons": [{ "code": "ArrowUp", "label": "Jump", "hold": false }] }
    ]
  },

  "thomas": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "Space", "label": "Jump", "hold": false },
          { "code": "ShiftLeft", "label": "Slide" },
          { "code": "KeyV", "label": "Dash", "hold": false },
          { "code": "KeyB", "label": "Shop", "hold": false }
        ]
      }
    ]
  },

  "luke-d": {
    "landscape": true,
    "clusters": [
      {
        "side": "left",
        "pad": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" }
      },
      {
        "side": "right",
        "buttons": [
          { "code": "KeyR", "label": "Load", "hold": false, "ariaLabel": "Reload" },
          { "code": "KeyC", "label": "Crouch" }
        ]
      }
    ]
  }
}
