{
  "version": 1,
  "terms": [
    {
      "term": "alkali metal",
      "aliases": ["alkali metals"],
      "pronunciation": "AL-kuh-ly MET-ul",
      "ipa": "/ˈælkəlaɪ ˈmɛtəl/",
      "definition": "A highly reactive metal in group 1 of the periodic table, such as lithium, sodium, or potassium.",
      "etymology": "https://en.wiktionary.org/wiki/alkali_metal"
    },
    {
      "term": "atom",
      "aliases": ["atoms"],
      "pronunciation": "AT-um",
      "ipa": "/ˈætəm/",
      "definition": "The smallest unit of an element that still has that element’s chemical properties.",
      "etymology": "https://en.wiktionary.org/wiki/atom#Etymology"
    },
    {
      "term": "atomic number",
      "pronunciation": "uh-TOM-ik NUM-ber",
      "ipa": "/əˈtɑːmɪk ˈnʌmbər/",
      "definition": "The number of protons in an atom’s nucleus; it identifies which element the atom is.",
      "etymology": "https://en.wiktionary.org/wiki/atomic_number"
    },
    {
      "term": "chemical bond",
      "aliases": ["chemical bonds", "bonding"],
      "pronunciation": "KEM-ih-kul bond",
      "ipa": "/ˈkɛmɪkəl bɑːnd/",
      "definition": "An attraction that holds atoms or ions together by sharing or transferring electrons.",
      "etymology": "https://en.wiktionary.org/wiki/chemical_bond"
    },
    {
      "term": "electron cloud",
      "aliases": ["electron clouds"],
      "pronunciation": "ee-LEK-tron klowd",
      "ipa": "/ɪˈlɛktrɑːn klaʊd/",
      "definition": "A model showing the regions around a nucleus where an electron is likely to be found.",
      "etymology": "https://en.wiktionary.org/wiki/electron_cloud"
    },
    {
      "term": "element",
      "aliases": ["elements"],
      "pronunciation": "EL-uh-ment",
      "ipa": "/ˈɛləmənt/",
      "definition": "A pure substance made of atoms that all have the same number of protons.",
      "etymology": "https://en.wiktionary.org/wiki/element#Etymology"
    },
    {
      "term": "group",
      "aliases": ["groups"],
      "pronunciation": "groop",
      "ipa": "/ɡruːp/",
      "definition": "A vertical column of the periodic table. Elements in a group often behave similarly because they have related valence-electron patterns.",
      "etymology": "https://en.wiktionary.org/wiki/group#Etymology"
    },
    {
      "term": "halogen",
      "aliases": ["halogens"],
      "pronunciation": "HAL-uh-jun",
      "ipa": "/ˈhælədʒən/",
      "definition": "A reactive nonmetal in group 17, such as fluorine, chlorine, bromine, or iodine.",
      "etymology": "https://en.wiktionary.org/wiki/halogen#Etymology"
    },
    {
      "term": "metalloid",
      "aliases": ["metalloids"],
      "pronunciation": "MET-uh-loyd",
      "ipa": "/ˈmɛtəˌlɔɪd/",
      "definition": "An element with a mixture of metallic and nonmetallic properties, often useful as a semiconductor.",
      "etymology": "https://en.wiktionary.org/wiki/metalloid#Etymology"
    },
    {
      "term": "noble gas",
      "aliases": ["noble gases"],
      "pronunciation": "NOH-bul gas",
      "ipa": "/ˈnoʊbəl ɡæs/",
      "definition": "An element in group 18 with a filled outer electron shell, making it unusually unreactive.",
      "etymology": "https://en.wiktionary.org/wiki/noble_gas"
    },
    {
      "term": "period",
      "aliases": ["periods"],
      "pronunciation": "PEER-ee-ud",
      "ipa": "/ˈpɪriəd/",
      "definition": "A horizontal row of the periodic table. Atomic number increases by one from left to right.",
      "etymology": "https://en.wiktionary.org/wiki/period#Etymology"
    },
    {
      "term": "periodic table",
      "pronunciation": "peer-ee-OD-ik TAY-bul",
      "ipa": "/ˌpɪriˈɑːdɪk ˈteɪbəl/",
      "definition": "A chart that orders elements by atomic number and lines up repeating patterns in their chemical properties.",
      "etymology": "https://en.wiktionary.org/wiki/periodic_table"
    },
    {
      "term": "proton",
      "aliases": ["protons"],
      "pronunciation": "PROH-ton",
      "ipa": "/ˈproʊtɑːn/",
      "definition": "A positively charged particle in an atom’s nucleus. The number of protons determines the element.",
      "etymology": "https://en.wiktionary.org/wiki/proton#Etymology"
    },
    {
      "term": "reactivity",
      "pronunciation": "ree-ak-TIV-ih-tee",
      "ipa": "/ˌriːækˈtɪvəti/",
      "definition": "How readily a substance undergoes a chemical change when it meets other substances.",
      "etymology": "https://en.wiktionary.org/wiki/reactivity#Etymology"
    },
    {
      "term": "unit cell",
      "pronunciation": "YOO-nit sel",
      "ipa": "/ˈjuːnɪt sɛl/",
      "definition": "The smallest repeating three-dimensional pattern that can build an entire crystal lattice.",
      "etymology": "https://en.wiktionary.org/wiki/unit_cell"
    },
    {
      "term": "valence electron",
      "aliases": ["valence electrons", "outer electron", "outer electrons"],
      "pronunciation": "VAY-lens ee-LEK-tron",
      "ipa": "/ˈveɪləns ɪˈlɛktrɑːn/",
      "definition": "An electron in an atom’s outermost occupied shell that helps determine bonding and reactivity.",
      "etymology": "https://en.wiktionary.org/wiki/valence_electron"
    },
    {
      "term": "X-ray diffraction",
      "pronunciation": "EKS-ray dih-FRAK-shun",
      "ipa": "/ˈɛksˌreɪ dɪˈfrækʃən/",
      "definition": "A method that uses the way X-rays scatter from a material to determine how its atoms are arranged.",
      "etymology": "https://en.wiktionary.org/wiki/X-ray_diffraction"
    }
  ]
}
