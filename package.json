{
  "name": "githubtutorialsteam",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:student-drive": "node scripts/audit-student-drive.mjs",
    "import:student-drive": "node scripts/import-student-drive-projects.mjs",
    "build": "node build-showcase.js",
    "build:plato-model": "node scripts/build-plato-cave-model.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "update:votd": "node scripts/update-votd.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "check:manifest-overrides": "node scripts/check-manifest-overrides.mjs",
    "check:lessons": "node scripts/sync-lessons.mjs",
    "check:new-games": "node scripts/check-new-student-games.mjs",
    "check:themes": "node scripts/check-theme-contrast.mjs",
    "check:theme-readability": "node scripts/check-theme-readability.mjs",
    "check:lesson-print": "node scripts/check-lesson-print.mjs",
    "audit:lesson-print": "node scripts/check-lesson-print.mjs --render",
    "sync:lesson-print-buttons": "node scripts/sync-lesson-print-buttons.mjs",
    "check:lesson-print-buttons": "node scripts/sync-lesson-print-buttons.mjs --check",
    "build:compendium-outline": "node scripts/build-compendium-outline.mjs",
    "check:compendium-plan": "node scripts/build-compendium-outline.mjs --check",
    "sync:steam-lessons-compendium": "node scripts/sync-steam-lessons-compendium.mjs",
    "a11y": "node scripts/run-a11y.mjs",
    "a11y:update-baseline": "node scripts/run-a11y.mjs --update-baseline",
    "a11y:page": "node scripts/run-a11y.mjs --no-baseline --match",
    "quality": "npm run check:integrity && npm run check:manifest-overrides && npm run check:themes && npm run check:lesson-print-buttons && npm run check:compendium-plan && npm run check:lessons && npm run check:new-games",
    "build:d3": "esbuild scripts/d3-galaxy-entry.js --bundle --format=esm --minify --outfile=assets/vendor/d3-galaxy.min.js",
    "build:math-viz": "esbuild scripts/math-worksheet-viz-entry.js --bundle --format=iife --global-name=MathWorksheetVizBundle --minify --outfile=assets/vendor/math-worksheet-viz.min.js",
    "build:three": "esbuild scripts/three-bundle-entry.js --bundle --format=esm --minify --outfile=assets/vendor/three-bundle.min.js",
    "build:starter-packs": "node scripts/build-starter-packs.mjs",
    "build:matter": "esbuild scripts/matter-bundle-entry.js --bundle --format=esm --minify --outfile=assets/vendor/matter-bundle.min.js",
    "build:blockly": "esbuild scripts/blockly-browser-entry.js --bundle --format=iife --minify --outfile=assets/vendor/blockly.min.js",
    "build:tone": "esbuild scripts/tone-browser-entry.js --bundle --format=iife --minify --outfile=assets/vendor/tone.min.js && node scripts/strip-trailing-whitespace.mjs assets/vendor/tone.min.js",
    "build:firebase": "esbuild scripts/firebase-compat-entry.js --bundle --format=iife --minify --outfile=assets/vendor/firebase-compat.min.js",
    "build:classroom-vendors": "npm run build:blockly && npm run build:tone && npm run build:firebase"
  },
  "devDependencies": {
    "@fontsource/patrick-hand": "^5.3.0",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "blockly": "^13.2.1",
    "clean-css-cli": "^5.6.3",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "esbuild": "^0.25.10",
    "firebase": "^12.18.0",
    "html-minifier-terser": "^7.2.0",
    "matter-js": "^0.20.0",
    "openmoji": "^17.0.0",
    "pa11y": "^10.0.0",
    "playwright": "^1.62.1",
    "puppeteer": "^25.9.0",
    "serve": "^14.2.4",
    "sharp": "^0.35.4",
    "three": "^0.180.0",
    "tone": "^14.9.17",
    "wait-on": "^9.1.0"
  }
}
